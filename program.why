use int.Int
use int.EuclideanDivision

let g(a b: int) : int
  requires { ((a >= b) \/ ((div a b) >= 1) /\ (b <> 0))
         /\ ((a < b) \/ ((div b a >= 1) /\ (a <> 0)))}
  returns { rg -> rg >= 1 }
  = if (a >= b) then div a b else div b a


let abs (a b: int) : int
  requires { true }
  returns { rabs -> rabs >= 0}
  = if (a < b) then b - a else a - b
  
let rec fib (n: int) : int =
  if n = 0 then 0
    else
   if n = 1 then 1
    else fib(n - 1) + fib(n - 2)
    
let gcd(a b: int) : int =
  let ref aux = a in
  while (aux <> b) do
    if aux > b then aux <- a - b;
  done;
  aux;