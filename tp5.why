use int.Int
use ref.Ref
use array.Array
use int.EuclideanDivision
use array.IntArraySorted

let binarysearch(a: array int) (elem: int) =
  requires { sorted a }
  requires { 0 < length a }
  ensures { a[result] = elem \/ result = -1 }
  let ref l = 0 in
  let ref u = length a - 1 in
  while (l <= u) do
    invariant { forall i. 0 <= i < length a -> a[i] = elem -> l <= i <= u }
    invariant { 0 <= l }
    invariant { u < length a }
    variant { u - l }
    let ref m = l + div (u - l) 2 in
    if (a[m] < elem) then
      l <- m + 1
    else
      if (a[m] > elem) then
        u <- m - 1
      else
        return m;
  done;
  return -1